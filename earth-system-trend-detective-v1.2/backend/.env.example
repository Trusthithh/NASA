APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
NASA_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
CACHE_TTL_SECONDS=3600

# Maximum assistant requests per client IP per rolling minute (per backend process)
ASSISTANT_RATE_LIMIT_PER_MINUTE=12
